# Dependencies
node_modules/

# Build outputs
# dist/ is COMMITTED on purpose: npm git-dependency installs ship only
# git-tracked files, so the GitHub-direct install path needs the built
# artifacts in the repository. Rebuild and commit after source changes
# (CI has a git-diff drift gate). Debug .map files stay out.
# dist/web-ui (vite output) stays OUT: its html is not byte-deterministic
# across platforms/Node versions (vite preserves source line endings), so
# it would flake the drift gate; only `octie serve` needs it, and npm
# tarballs still ship it (prepack rebuilds from files list).
!dist/
!dist/**
dist/**/*.map
dist/web-ui/
build/
*.log

# Octie project data
.octie/
*.octie
tasks.json

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Test coverage
coverage/
.nyc_output/
html/

# Temporary files
tmp/
temp/
*.tmp

# Lock files (optional, uncomment if needed)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
